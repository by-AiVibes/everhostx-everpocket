{
    "env": {
        "browser": true,
        "commonjs": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 13
    },
    "rules": {
        "no-async-promise-executor": "off",
        "no-unused-vars": "off",
        "no-restricted-properties": ["error", {
            "object": "Math",
            "property": "random",
            "message": "Use crypto.randomBytes instead of Math.random."
        }]
    }
}